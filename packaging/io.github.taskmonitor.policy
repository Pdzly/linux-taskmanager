<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Installed to /usr/share/polkit-1/actions/. Lets pkexec show a TaskMonitor-specific
     prompt instead of the generic "run a program as root" one. -->
<policyconfig>
  <vendor>TaskMonitor</vendor>
  <action id="io.github.taskmonitor.helper">
    <description>Manage another user's process</description>
    <message>TaskMonitor needs administrator rights to change a process you don't own</message>
    <icon_name>utilities-system-monitor</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/taskmonitor-helper</annotate>
  </action>
</policyconfig>
