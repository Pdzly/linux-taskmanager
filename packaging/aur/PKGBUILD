# Arch Linux / Manjaro / EndeavourOS recipe. Builds from source with the system Rust.
# Publishing to the AUR needs a public source URL: set _repo below, then
# `makepkg --printsrcinfo > .SRCINFO` and push both files to aur.archlinux.org/taskmonitor.git.
# To build locally from this checkout instead: `makepkg -si` with source=() pointing at it.
_repo=https://github.com/YOUR-NAME/taskmonitor
pkgname=taskmonitor
pkgver=0.1.0
pkgrel=1
pkgdesc="A modern task manager for Linux"
arch=('x86_64' 'aarch64')
url="$_repo"
license=('LicenseRef-unspecified')
depends=('fontconfig' 'libxkbcommon' 'polkit' 'hicolor-icon-theme')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$_repo/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    cargo build --frozen --release -p taskmonitor -p taskmonitor-helper
}

check() {
    cd "$pkgname-$pkgver"
    cargo test --frozen --release -p taskmonitor-core
}

package() {
    cd "$pkgname-$pkgver"
    packaging/stage.sh target/release "$pkgdir/usr"
}
