import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Card, Badge } from "../components.slint";
import { Cell, HeatCell } from "../table.slint";
import { Button } from "../dialogs.slint";
import { HistoryRow } from "../types.slint";

global HCols {
    out property <length> num: 130px;
}

component Header inherits HorizontalLayout {
    in property <string> text;
    width: HCols.num;
    padding-right: 12px;
    Cell { text: root.text; font-size: 12px; color: Theme.text-2; horizontal-alignment: right; }
}

export component HistoryPage inherits Card {
    in property <[HistoryRow]> rows;
    in property <bool> enabled;
    in property <string> since;
    callback enable();
    callback clear();

    VerticalLayout {
        padding: 20px;
        padding-bottom: 8px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: "App history"; font-size: 22px; font-weight: 500; color: Theme.text; }
                Text {
                    text: root.enabled ? "Resources each app has used " + root.since + ". Kept only on this computer." : "Off";
                    font-size: 12px;
                    color: Theme.text-2;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.enabled: VerticalLayout {
                alignment: center;
                Button { text: "Clear history"; clicked => { root.clear(); } }
            }
        }

        if !root.enabled: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 14px;
            Text {
                text: "Keep track of how much CPU, disk and GPU time each app uses, across restarts.";
                font-size: 14px;
                color: Theme.text-2;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                Button { text: "Turn on app history"; primary: true; clicked => { root.enable(); } }
            }
        }

        if root.enabled: HorizontalLayout {
            height: 30px;
            padding-left: 12px;
            Cell { horizontal-stretch: 1; text: "App"; font-size: 12px; color: Theme.text-2; }
            Header { text: "CPU time"; }
            Header { text: "Disk read"; }
            Header { text: "Disk written"; }
            Header { text: "GPU time"; }
        }
        if root.enabled: Rectangle { height: 1px; background: Theme.line; }

        if root.enabled && root.rows.length == 0: Text {
            vertical-stretch: 1;
            text: "Nothing recorded yet. Apps appear here as they run.";
            color: Theme.text-2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.enabled && root.rows.length > 0: ListView {
            vertical-stretch: 1;
            for row in root.rows: HorizontalLayout {
                height: 48px;
                padding-left: 12px;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Badge { text: row.initials; tone: Theme.badges[row.tone]; size: 30px; }
                    }
                    Cell { text: row.name; font-weight: 500; }
                }
                HeatCell { width: HCols.num; text: row.cpu; heat: row.cpu-heat; }
                HeatCell { width: HCols.num; text: row.read; heat: 0; }
                HeatCell { width: HCols.num; text: row.write; heat: 0; }
                HeatCell { width: HCols.num; text: row.gpu; heat: 0; }
            }
        }
    }
}
