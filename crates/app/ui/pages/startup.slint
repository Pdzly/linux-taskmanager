import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Card, Badge, Switch, Chip, AppIcon } from "../components.slint";
import { StartupRow } from "../types.slint";

export component StartupPage inherits Card {
    in property <[StartupRow]> rows;
    in property <[image]> icons;
    callback toggled(string, bool);

    VerticalLayout {
        padding: 20px;
        padding-bottom: 8px;
        spacing: 12px;

        VerticalLayout {
            spacing: 2px;
            Text { text: "Startup apps"; font-size: 22px; font-weight: 500; color: Theme.text; }
            Text {
                text: "Programs that start when you sign in. Turning one off only affects your account.";
                font-size: 12px;
                color: Theme.text-2;
            }
        }
        Rectangle { height: 1px; background: Theme.line; }

        ListView {
            vertical-stretch: 1;
            for row in root.rows: Rectangle {
                height: 60px;
                border-radius: 12px;
                background: ta.has-hover ? Theme.tile.with-alpha(0.5) : transparent;
                ta := TouchArea { }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 16px;
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        AppIcon { icons: root.icons; icon: row.icon; initials: row.initials; tone: Theme.badges[row.tone]; size: 34px; }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: row.name; font-size: 14px; font-weight: 500; color: row.enabled ? Theme.text : Theme.text-2; overflow: elide; }
                        Text { text: row.command; font-size: 12px; font-family: Theme.mono; color: Theme.text-2; overflow: elide; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Chip { text: row.source; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { width: 70px; text: row.enabled ? "Enabled" : "Disabled"; font-size: 12.5px; color: Theme.text-2; horizontal-alignment: right; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Switch {
                            on: row.enabled;
                            label: "Start " + row.name + " at sign in";
                            toggled => { root.toggled(row.id, !row.enabled); }
                        }
                    }
                }
            }
        }
    }
}
