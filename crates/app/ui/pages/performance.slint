import { Theme } from "../theme.slint";
import { Card, CardHeader, Chip, Stat, Badge, IconButton, AngledTab, Graph, Icon, AppIcon } from "../components.slint";
import { Icons } from "../icons.slint";
import { CpuView, MemView, DeviceView, SysView, DiskProcRow } from "../types.slint";

// Yellow-banded hero card (the reference's "To do list" card).
component CpuCard inherits Rectangle {
    in property <CpuView> cpu;
    in property <[float]> core-load;
    property <bool> per-core;

    background: Theme.accent;
    border-radius: Theme.radius-card;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.shadow;

    VerticalLayout {
        // Header band
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 16px;
            height: 52px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icon { glyph: Icons.cpu; size: 18px; tint: Theme.on-accent; }
            }
            Text {
                text: root.cpu.model;
                font-size: 15px;
                font-weight: 500;
                color: Theme.on-accent;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.core-load.length + " threads";
                font-size: 13px;
                color: Theme.on-accent;
                vertical-alignment: center;
            }
        }

        // Inner white sheet, inset 2px so the yellow shows as a thin rim
        HorizontalLayout {
            padding-left: 2px;
            padding-right: 2px;
            padding-bottom: 2px;
            Rectangle {
                background: Theme.card;
                border-radius: Theme.radius-card - 2px;

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Chip {
                            text: "Utilization";
                            clickable: true;
                            selected: !root.per-core;
                            clicked => { root.per-core = false; }
                        }
                        Chip {
                            text: "Per core";
                            clickable: true;
                            selected: root.per-core;
                            clicked => { root.per-core = true; }
                        }
                    }

                    HorizontalLayout {
                        spacing: 20px;
                        VerticalLayout {
                            alignment: end;
                            min-width: 150px;
                            Text {
                                text: root.cpu.usage;
                                font-size: 84px;
                                font-weight: 300;
                                letter-spacing: -3px;
                                color: Theme.text;
                            }
                            Text { text: "% utilization"; font-size: 12px; color: Theme.text-2; }
                        }
                        if !root.per-core: Graph {
                            horizontal-stretch: 1;
                            line-a: root.cpu.graph-line;
                            fill-a: root.cpu.graph-fill;
                            scale: "100%";
                        }
                        // One bar per logical CPU; the filled part grows with load (0..1).
                        if root.per-core: HorizontalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            for load in root.core-load: Rectangle {
                                background: Theme.tile;
                                border-radius: 4px;
                                Rectangle {
                                    y: parent.height - self.height;
                                    height: parent.height * clamp(load, 0, 1);
                                    background: Theme.accent;
                                    border-radius: 4px;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 24px;
                        Stat { label: "Speed"; value: root.cpu.speed; }
                        Stat { label: "Processes"; value: root.cpu.processes; }
                        Stat { label: "Threads"; value: root.cpu.threads; }
                    }
                }
            }
        }
    }
}

// Big-numeral card (the reference's "Sunday, Feb 10" card).
component MemoryCard inherits Card {
    in property <MemView> mem;

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        CardHeader { title: "Memory"; subtitle: root.mem.total + " total"; }
        Rectangle {
            background: Theme.tile;
            border-radius: Theme.radius-tile;
            vertical-stretch: 1;
            VerticalLayout {
                padding: 16px;
                alignment: center;
                Text { text: "In use"; font-size: 13px; color: Theme.text-2; horizontal-alignment: center; }
                Text {
                    text: root.mem.used;
                    font-size: 72px;
                    font-weight: 300;
                    letter-spacing: -2px;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                Text { text: "GB"; font-size: 13px; color: Theme.text-2; horizontal-alignment: center; }
            }
        }
        // Composition: in use, then cache, then free. Deliberately not animated:
        // an animation re-renders every frame for its duration on each tick (measured 2.5% vs 1.1% CPU).
        Rectangle {
            height: 8px;
            border-radius: 4px;
            background: Theme.tile;
            clip: true;
            Rectangle {
                x: 0;
                width: parent.width * clamp(root.mem.used-frac, 0, 1);
                background: Theme.text;
            }
            Rectangle {
                x: parent.width * clamp(root.mem.used-frac, 0, 1);
                width: parent.width * clamp(root.mem.cached-frac, 0, 1 - root.mem.used-frac);
                background: Theme.accent;
            }
        }
        HorizontalLayout {
            spacing: 12px;
            Stat { label: "Available"; value: root.mem.available; }
            Stat { label: "Cached"; value: root.mem.cached; }
            Stat { label: "Swap"; value: root.mem.swap; }
        }
    }
}

component UsersCard inherits Card {
    callback open-users();
    in property <string> user-name;
    in property <string> user-initials;
    in property <string> session;

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout { alignment: center; Icon { glyph: Icons.users; size: 18px; } }
            Text { text: "Users"; font-size: 16px; font-weight: 500; color: Theme.text; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Badge { text: root.user-initials; tone: Theme.badges[3]; online: true; }
            }
        }
        // One tile per logged-in session; M5 fills this from logind.
        Rectangle {
            background: Theme.tile;
            border-radius: Theme.radius-tile;
            height: 72px;
            HorizontalLayout {
                padding: 14px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Badge { text: root.user-initials; tone: Theme.badges[3]; size: 40px; online: true; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: root.user-name; font-size: 14px; font-weight: 500; color: Theme.text; }
                    Text { text: root.session; font-size: 12px; color: Theme.text-2; }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    IconButton { icon: Icons.open; label: "Open Users"; size: 36px; icon-size: 16px; clicked => { root.open-users(); } }
                }
            }
        }
        Rectangle {
            border-radius: Theme.radius-tile;
            border-width: 1.5px;
            border-color: Theme.line;
            background: users-ta.has-hover ? Theme.tile : transparent;
            height: 56px;
            Text { text: "See every session and its CPU and memory use  →"; font-size: 12px; color: Theme.text-2; }
            users-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-users(); }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

// Disks / network adapters (the reference's "Detailed Report" card): device chips,
// a two-series graph and a row of numbers for the selected device.
component DeviceCard inherits Card {
    in property <string> title;
    in property <string> empty-text;
    in property <[DeviceView]> devices;
    in-out property <int> selected;
    // Out-of-range indexing yields an empty DeviceView, so no bounds check is needed.
    property <DeviceView> current: root.devices[root.selected];

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        CardHeader { title: root.title; subtitle: root.current.subtitle; }

        if root.devices.length == 0: Text {
            vertical-stretch: 1;
            text: root.empty-text;
            color: Theme.text-2;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.devices.length > 0: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for d[i] in root.devices: Chip {
                text: d.name;
                mono: true;
                clickable: true;
                selected: i == root.selected;
                clicked => { root.selected = i; }
            }
        }
        if root.devices.length > 0: Graph {
            vertical-stretch: 1;
            min-height: 60px;
            line-a: root.current.line-a;
            fill-a: root.current.fill-a;
            line-b: root.current.line-b;
            scale: root.current.scale;
        }
        if root.devices.length > 0: HorizontalLayout {
            spacing: 12px;
            for m[i] in root.current.metrics: VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    // Legend swatches for the two graphed series.
                    if i < 2: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: i == 0 ? Theme.accent-strong : Theme.text;
                        }
                    }
                    Text { text: m.label; font-size: 12.5px; color: Theme.text; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    Text { text: m.value; font-size: 24px; font-weight: 300; color: Theme.text; font-family: Theme.mono; }
                    Text { text: m.unit; font-size: 11px; color: Theme.text-2; vertical-alignment: bottom; }
                }
            }
        }
    }
}

// Processes reading and writing the most right now (the reference's "AI Chat" card slot).
component DiskActivityCard inherits Card {
    in property <[DiskProcRow]> rows;
    in property <[image]> icons;

    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout { alignment: center; Icon { glyph: Icons.disk; size: 18px; } }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: "Disk activity"; font-size: 16px; font-weight: 500; color: Theme.text; }
                Text { text: "Processes reading and writing the most"; font-size: 12px; color: Theme.text-2; }
            }
        }
        HorizontalLayout {
            padding-left: 38px;
            Text { horizontal-stretch: 1; text: "Process"; font-size: 12px; color: Theme.text-2; }
            Text { width: 92px; text: "Read"; font-size: 12px; color: Theme.text-2; horizontal-alignment: right; }
            Text { width: 92px; text: "Write"; font-size: 12px; color: Theme.text-2; horizontal-alignment: right; }
        }
        if root.rows.length == 0: Text {
            vertical-stretch: 1;
            text: "No disk activity right now";
            font-size: 13px;
            color: Theme.text-2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        for row in root.rows: HorizontalLayout {
            height: 30px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                AppIcon { icons: root.icons; icon: row.icon; initials: row.initials; tone: Theme.badges[row.tone]; size: 24px; }
            }
            Text { horizontal-stretch: 1; text: row.name; font-size: 13px; color: Theme.text; vertical-alignment: center; overflow: elide; }
            Text { width: 92px; text: row.read; font-size: 12.5px; font-family: Theme.mono; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
            Text { width: 92px; text: row.write; font-size: 12.5px; font-family: Theme.mono; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
        }
        if root.rows.length > 0: Rectangle { vertical-stretch: 1; }
        Text {
            text: "Only your own processes: Linux keeps other users' disk figures private.";
            font-size: 11px;
            color: Theme.text-2;
            wrap: word-wrap;
        }
    }
}

// The reference's "Performances 5.7" card.
component SystemCard inherits Card {
    in property <SysView> sys;
    in property <string> uptime;

    VerticalLayout {
        padding: 20px;
        spacing: 4px;
        CardHeader { title: "System"; subtitle: "Load average, 1 min"; }
        Rectangle { vertical-stretch: 1; }
        Text { text: root.sys.load1; font-size: 72px; font-weight: 300; letter-spacing: -2px; color: Theme.text; }
        Text { text: root.sys.load-detail; font-size: 12px; color: Theme.text-2; font-family: Theme.mono; }
        Text { text: "Uptime " + root.uptime; font-size: 12px; color: Theme.text-2; font-family: Theme.mono; }
    }
}

export component PerformancePage inherits VerticalLayout {
    in property <string> user-name;
    in property <string> user-initials;
    in property <string> uptime;
    in property <CpuView> cpu;
    in property <MemView> mem;
    in property <SysView> sys;
    in property <[float]> core-load;
    in property <[DeviceView]> disks;
    in property <[DeviceView]> nets;
    in property <[DeviceView]> gpus;
    in-out property <int> tab: 0;
    in property <[DiskProcRow]> disk-procs;
    in property <[image]> icons;
    callback tab-changed(int);
    callback open-users();

    changed tab => { root.tab-changed(self.tab); }
    property <int> gpu-index: 0;
    property <int> disk-index: 0;
    property <int> net-index: 0;

    spacing: 0px;

    HorizontalLayout {
        spacing: 16px;
        height: 330px;
        CpuCard {
            horizontal-stretch: 1.3;
            cpu: root.cpu;
            core-load: root.core-load;
        }
        MemoryCard {
            width: 270px;
            mem: root.mem;
        }
        UsersCard {
            horizontal-stretch: 1;
            user-name: root.user-name;
            user-initials: root.user-initials;
            session: "Local session · this seat";
            open-users => { root.open-users(); }
        }
    }

    Rectangle { height: 18px; }

    HorizontalLayout {
        spacing: 0px;
        alignment: start;
        AngledTab { text: "Disk"; active: root.tab == 0; clicked => { root.tab = 0; } }
        AngledTab { text: "Network"; active: root.tab == 1; clicked => { root.tab = 1; } }
        AngledTab { text: "GPU"; active: root.tab == 2; clicked => { root.tab = 2; } }
    }

    Rectangle {
        background: Theme.panel;
        border-radius: Theme.radius-card;
        border-top-left-radius: 0px;
        vertical-stretch: 1;

        HorizontalLayout {
            padding: 16px;
            spacing: 16px;

            if root.tab == 0: DeviceCard {
                horizontal-stretch: 1.4;
                title: "Disks";
                empty-text: "No physical disks found";
                devices: root.disks;
                selected <=> root.disk-index;
            }
            if root.tab == 1: DeviceCard {
                horizontal-stretch: 1.4;
                title: "Network";
                empty-text: "No network adapters found";
                devices: root.nets;
                selected <=> root.net-index;
            }
            if root.tab == 2: DeviceCard {
                horizontal-stretch: 1.4;
                title: "Graphics";
                empty-text: "No GPUs found";
                devices: root.gpus;
                selected <=> root.gpu-index;
            }
            DiskActivityCard {
                horizontal-stretch: 1.1;
                rows: root.disk-procs;
                icons: root.icons;
            }
            SystemCard {
                width: 230px;
                sys: root.sys;
                uptime: root.uptime;
            }
        }
    }
}
