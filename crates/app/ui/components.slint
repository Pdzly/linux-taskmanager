import { Theme } from "theme.slint";
import { Icons } from "icons.slint";

// A Lucide glyph. Icons are a font because the software renderer caches glyphs
// but re-rasterizes SVG images on every draw.
export component Icon inherits Text {
    in property <string> glyph;
    in property <length> size: 20px;
    in property <color> tint: Theme.text;
    text: glyph;
    font-family: Icons.font;
    font-size: size;
    color: tint;
    width: size;
    height: size;
    horizontal-alignment: center;
    vertical-alignment: center;
    accessible-role: none;
}

// White rounded panel; put a layout inside it.
export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius-card;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.shadow;
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <length> size: 44px;
    in property <length> icon-size: 20px;
    in property <bool> active;
    in property <bool> outlined;
    in property <bool> danger;
    callback clicked;

    width: size;
    height: size;
    border-radius: self.width / 2;
    background: danger ? (ta.has-hover ? Theme.danger.darker(0.12) : Theme.danger)
        : active ? Theme.card
        : ta.has-hover ? Theme.hover
        : outlined ? transparent : Theme.tile;
    border-width: outlined && !active ? 1.5px : 0px;
    border-color: Theme.outline;
    drop-shadow-blur: active ? 14px : 0px;
    drop-shadow-color: Theme.shadow;
    animate background { duration: 120ms; }

    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }

    Icon {
        glyph: root.icon;
        size: root.icon-size;
        tint: root.danger ? #ffffff : Theme.text;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Coloured circle with initials, like the avatars in the reference design.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.badges[0];
    in property <length> size: 30px;
    in property <bool> online;

    width: size;
    height: size;
    border-radius: size / 2;
    background: tone;
    border-width: 2px;
    border-color: Theme.card;

    Text {
        text: root.text;
        color: #ffffff;
        font-size: root.size * 0.36;
        font-weight: 600;
    }

    if root.online: Rectangle {
        x: root.width - 9px;
        y: root.height - 9px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.ok;
        border-width: 2px;
        border-color: Theme.card;
    }
}

// Small rounded label, optionally with an icon.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> mono;
    // Set `clickable` to use the chip as a toggle/segment.
    in property <bool> clickable;
    in property <bool> selected;
    callback clicked;

    height: 30px;
    border-radius: self.height / 2;
    background: selected ? Theme.text : clickable && ta.has-hover ? Theme.hover : Theme.tile;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;

        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { glyph: root.icon; size: 14px; tint: Theme.text-2; }
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.card : Theme.text;
            font-size: 12.5px;
            font-family: root.mono ? Theme.mono : "Mona Sans";
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Area/line graph. Paths come from Rust in a 0..100 × 0..100 box, newest sample on the right.
export component Graph inherits Rectangle {
    in property <string> line-a;
    in property <string> fill-a;
    in property <string> line-b;
    in property <color> color-a: Theme.accent-strong;
    in property <color> color-b: Theme.text;
    in property <string> scale;

    border-radius: Theme.radius-tile;
    background: Theme.tile;
    clip: true;

    for i in 3: Rectangle {
        y: parent.height * (i + 1) / 4;
        height: 1px;
        background: Theme.line;
    }
    if root.fill-a != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fit: fill;
        commands: root.fill-a;
        fill: root.color-a.with-alpha(0.22);
    }
    if root.line-a != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fit: fill;
        commands: root.line-a;
        stroke: root.color-a;
        stroke-width: 2px;
    }
    if root.line-b != "": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fit: fill;
        commands: root.line-b;
        stroke: root.color-b;
        stroke-width: 1.5px;
    }
    if root.scale != "": Text {
        x: parent.width - self.width - 10px;
        y: 8px;
        text: root.scale;
        font-size: 11px;
        font-family: Theme.mono;
        color: Theme.text-2;
    }
}

// Caption over a value.
export component Stat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <length> value-size: 15px;

    spacing: 2px;
    Text {
        text: root.label;
        color: Theme.text-2;
        font-size: 12px;
        overflow: elide;
    }
    Text {
        text: root.value;
        color: Theme.text;
        font-size: root.value-size;
        font-family: Theme.mono;
        overflow: elide;
    }
}

// Card title with an optional subtitle. Keeps the height the old "more" button gave it,
// so card layouts don't shift.
export component CardHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;

    min-height: 32px;
    spacing: 8px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 16px;
            font-weight: 500;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.text-2;
            font-size: 12px;
        }
    }
}

// Tab with a slanted right edge, as in the reference's "Project Overview" tab.
export component AngledTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    property <float> w: self.width / 1px;
    property <float> h: self.height / 1px;

    height: 44px;
    min-width: label.preferred-width + 64px;

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: root.w;
        viewbox-height: root.h;
        fill: root.active ? Theme.panel : transparent;
        stroke: root.active ? transparent : Theme.line;
        stroke-width: 1px;
        commands: "M 0 \{root.h} L 0 16 Q 0 0 16 0 L \{root.w - 44} 0 Q \{root.w - 33} 0 \{root.w - 28} 9 L \{root.w - 12} \{root.h - 5} Q \{root.w - 9} \{root.h} \{root.w} \{root.h} Z";
    }

    label := Text {
        x: 22px;
        text: root.text;
        color: root.active ? Theme.text : Theme.text-2;
        font-size: 15px;
        font-weight: root.active ? 500 : 400;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// App mark, rendered from logo/taskmonitorlogo.svg by `examples/render_icons.rs`.
// A PNG rather than the SVG: the software renderer decodes PNGs once but
// re-rasterizes SVGs every frame (and drops rounded corners on gradients).
export component Logo inherits Image {
    in property <length> size: 52px;
    width: size;
    height: size;
    source: @image-url("icons/logo-104.png");
    image-rendering: smooth;
}

// On/off switch.
export component Switch inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback toggled();

    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: root.on ? Theme.text : Theme.hover;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.toggled(); }

    Rectangle {
        x: root.on ? parent.width - self.width - 3px : 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.on ? Theme.accent : Theme.card;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// An app's icon when it has one, otherwise its initials badge.
export component AppIcon inherits Rectangle {
    in property <[image]> icons;
    // Index into `icons`, or -1 for none.
    in property <int> icon: -1;
    in property <string> initials;
    in property <color> tone;
    in property <length> size: 28px;

    width: size;
    height: size;
    if root.icon >= 0: Image {
        source: root.icons[root.icon];
        width: root.size;
        height: root.size;
        image-rendering: smooth;
    }
    if root.icon < 0: Badge {
        text: root.initials;
        tone: root.tone;
        size: root.size;
    }
}
