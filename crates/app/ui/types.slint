// Data the Rust side pushes into the UI each tick. Strings are pre-formatted in Rust.

export struct Summary {
    cpu: string,
    ram: string,
    gpu: string,
    uptime: string,
}

export struct CpuView {
    model: string,
    usage: string,
    speed: string,
    processes: string,
    threads: string,
    // SVG path commands in a 0..100 × 0..100 box.
    graph-line: string,
    graph-fill: string,
}

export struct MemView {
    total: string,
    used: string,
    available: string,
    cached: string,
    swap: string,
    used-frac: float,
    cached-frac: float,
}

export struct Metric {
    label: string,
    value: string,
    unit: string,
}

// One disk or network adapter: a chip, a subtitle, numbers and a two-series graph.
export struct DeviceView {
    name: string,
    subtitle: string,
    metrics: [Metric],
    line-a: string,
    fill-a: string,
    line-b: string,
    scale: string,
}

export struct SysView {
    load1: string,
    load-detail: string,
}

// One line of the Processes table.
export struct ProcRow {
    // 0 = section header, 1 = app/process (top level), 2 = process inside an expanded group
    kind: int,
    key: string,
    name: string,
    // "(4)" when the row groups several processes
    count: string,
    initials: string,
    tone: int,
    // Index into the window's app-icons, or -1 to show the initials badge.
    icon: int,
    expandable: bool,
    expanded: bool,
    status: string,
    cpu: string,
    cpu-heat: float,
    mem: string,
    mem-heat: float,
    disk: string,
    disk-heat: float,
    gpu: string,
    gpu-heat: float,
    suspended: bool,
    efficiency: bool,
}

// Column header figures (machine totals) for the Processes table.
export struct ProcTotals {
    count: string,
    cpu: string,
    mem: string,
    disk: string,
    gpu: string,
}

export struct DetailRow {
    key: string,
    name: string,
    pid: string,
    status: string,
    user: string,
    cpu: string,
    mem: string,
    threads: string,
    nice: string,
    cmd: string,
    read: string,
    write: string,
    suspended: bool,
    efficiency: bool,
}

export struct ServiceRow {
    name: string,
    description: string,
    // "Running", "Stopped", "Failed", "Starting", "Stopping", "Exited"
    status: string,
    // 0 stopped/exited, 1 running, 2 failed, 3 transitioning
    tone: int,
    startup: string,
    pid: string,
    can-enable: bool,
}

export struct StartupRow {
    id: string,
    name: string,
    command: string,
    initials: string,
    tone: int,
    icon: int,
    enabled: bool,
    source: string,
}

export struct UserRow {
    key: string,
    user: string,
    initials: string,
    tone: int,
    detail: string,
    status: string,
    processes: string,
    cpu: string,
    cpu-heat: float,
    mem: string,
    mem-heat: float,
}

export struct HistoryRow {
    name: string,
    initials: string,
    tone: int,
    icon: int,
    cpu: string,
    cpu-heat: float,
    read: string,
    write: string,
    gpu: string,
}

// A process on the Performance page's Disk activity card.
export struct DiskProcRow {
    name: string,
    initials: string,
    tone: int,
    icon: int,
    read: string,
    write: string,
}
