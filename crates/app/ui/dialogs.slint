import { Theme } from "theme.slint";
import { Card, Chip, Icon } from "components.slint";
import { Icons } from "icons.slint";
import { Metric } from "types.slint";

// Pill button for dialogs and page headers.
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    // For buttons sitting on a grey tile: white with a hairline border, so they
    // still read as buttons.
    in property <bool> raised;
    callback clicked;

    height: 40px;
    border-width: raised && !primary && !danger ? 1px : 0px;
    border-color: Theme.line;
    min-width: label.preferred-width + 36px;
    border-radius: self.height / 2;
    opacity: enabled ? 1 : 0.4;
    background: danger ? (ta.has-hover ? Theme.danger.darker(0.12) : Theme.danger)
        : primary ? (ta.has-hover ? Theme.text.transparentize(0.15) : Theme.text)
        : raised ? (ta.has-hover ? Theme.hover : Theme.card)
        : ta.has-hover ? Theme.hover : Theme.tile;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    label := Text {
        text: root.text;
        font-size: 13.5px;
        font-weight: 500;
        color: root.danger ? #ffffff : root.primary ? Theme.card : Theme.text;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Connected primary action and signal picker for process controls.
export component ProcessActionButton inherits Rectangle {
    in property <bool> enabled: true;
    callback request(string);

    height: 40px;
    min-width: end-task-label.preferred-width + 72px;
    border-radius: self.height / 2;
    clip: true;
    opacity: root.enabled ? 1 : 0.4;
    background: Theme.text;

    // Retains native menu focus, keyboard navigation, Escape, and click-away
    // behavior while the arrow requests it explicitly.
    menu-area := ContextMenuArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;

        Menu {
            MenuItem {
                title: "End task (SIGTERM, 15)";
                enabled: root.enabled;
                activated => { root.request("end"); }
            }
            MenuItem {
                title: "Kill process (SIGKILL, 9)";
                enabled: root.enabled;
                activated => { root.request("kill"); }
            }
            MenuItem {
                title: "Suspend (SIGSTOP)";
                enabled: root.enabled;
                activated => { root.request("suspend"); }
            }
            MenuItem {
                title: "Resume (SIGCONT)";
                enabled: root.enabled;
                activated => { root.request("resume"); }
            }
        }
    }

    primary-action := Rectangle {
        x: 0px;
        width: root.width - 36px;
        height: parent.height;
        background: primary-hit.has-hover || primary-focus.has-focus
            ? Theme.card.with-alpha(0.14) : transparent;
        accessible-role: button;
        accessible-label: "End task";
        accessible-action-default => {
            if root.enabled {
                root.request("end");
            }
        }

        primary-focus := FocusScope {
            width: parent.width;
            height: parent.height;
            enabled: root.enabled;
            focus-on-click: true;
            focus-on-tab-navigation: true;
            key-pressed(event) => {
                if event.text == Key.Return || event.text == Key.Space {
                    root.request("end");
                    return accept;
                }
                reject
            }

            end-task-label := Text {
                width: parent.width;
                text: "End task";
                font-size: 13.5px;
                font-weight: 500;
                color: Theme.card;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            primary-hit := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    primary-focus.focus();
                    root.request("end");
                }
            }
        }
    }

    Rectangle {
        x: root.width - 36px;
        y: 8px;
        width: 1px;
        height: root.height - 16px;
        background: Theme.card.with-alpha(0.32);
    }

    signal-menu := Rectangle {
        x: root.width - 36px;
        width: 36px;
        height: parent.height;
        background: signal-menu-hit.has-hover || signal-menu-focus.has-focus
            ? Theme.card.with-alpha(0.14) : transparent;
        accessible-role: button;
        accessible-label: "Choose process signal";
        accessible-action-default => {
            if root.enabled {
                menu-area.show({ x: root.width - 36px, y: root.height });
            }
        }

        signal-menu-focus := FocusScope {
            width: parent.width;
            height: parent.height;
            enabled: root.enabled;
            focus-on-click: true;
            focus-on-tab-navigation: true;
            key-pressed(event) => {
                if event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow {
                    menu-area.show({ x: root.width - 36px, y: root.height });
                    return accept;
                }
                reject
            }

            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                glyph: Icons.chevron-down;
                size: 16px;
                tint: Theme.card;
            }
            signal-menu-hit := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    signal-menu-focus.focus();
                    menu-area.show({ x: root.width - 36px, y: root.height });
                }
            }
        }
    }
}

// Dims the window and centres a card; clicking outside cancels.
component Modal inherits Rectangle {
    in property <length> card-width: 440px;
    callback dismiss();

    background: #00000059;
    TouchArea {
        clicked => { root.dismiss(); }
    }
    Card {
        width: root.card-width;
        height: content.preferred-height;
        drop-shadow-blur: 40px;
        drop-shadow-color: #00000040;
        // Swallow clicks so they don't reach the backdrop.
        TouchArea { }
        content := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            @children
        }
    }
}

export component ConfirmDialog inherits Modal {
    in property <string> title;
    in property <string> message;
    in property <string> confirm-text: "Confirm";
    callback confirmed();

    Text { text: root.title; font-size: 18px; font-weight: 500; color: Theme.text; wrap: word-wrap; }
    Text { text: root.message; font-size: 13.5px; color: Theme.text-2; wrap: word-wrap; }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button { text: "Cancel"; clicked => { root.dismiss(); } }
        Button { text: root.confirm-text; danger: true; clicked => { root.confirmed(); } }
    }
}

// Small icon button that copies text and briefly shows a check mark.
component CopyButton inherits Rectangle {
    in property <string> label: "Copy";
    callback copy();
    property <bool> done;

    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.copy(); }

    Icon { glyph: root.done ? Icons.check : Icons.copy; size: 14px; tint: root.done ? Theme.ok : Theme.text-2; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.copy();
            root.done = true;
            reset.running = true;
        }
    }
    reset := Timer {
        interval: 1.2s;
        running: false;
        triggered => {
            root.done = false;
            self.running = false;
        }
    }
}

export component PropertiesSheet inherits Modal {
    in property <string> title;
    in property <[Metric]> facts;
    // Every fact as "Label: value" lines, for Copy all.
    in property <string> all-text;
    callback copy(string);
    card-width: 660px;

    Text { text: root.title; font-size: 18px; font-weight: 500; color: Theme.text; }
    // Tight rows so the sheet fits the window at its 720 px minimum height.
    VerticalLayout {
        spacing: 0px;
        for fact in root.facts: HorizontalLayout {
            min-height: 28px;
            spacing: 12px;
            Text { width: 150px; text: fact.label; font-size: 12.5px; color: Theme.text-2; vertical-alignment: center; }
            Text {
                horizontal-stretch: 1;
                text: fact.value;
                font-size: 12.5px;
                font-family: Theme.mono;
                color: Theme.text;
                wrap: char-wrap;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: start;
                CopyButton { label: "Copy " + fact.label; copy => { root.copy(fact.value); } }
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Button { text: "Copy all"; clicked => { root.copy(root.all-text); } }
        Rectangle { horizontal-stretch: 1; }
        Button { text: "Close"; primary: true; clicked => { root.dismiss(); } }
    }
}

// Windows' "Run new task": start a command, detached from TaskMonitor.
export component RunTaskDialog inherits Modal {
    in property <string> user-name;
    callback run(string);
    card-width: 520px;

    Text { text: "Run new task"; font-size: 18px; font-weight: 500; color: Theme.text; }
    Text {
        text: "Type a command and press Enter. It runs as " + root.user-name + ", separate from TaskMonitor.";
        font-size: 13.5px;
        color: Theme.text-2;
        wrap: word-wrap;
    }
    Rectangle {
        height: 48px;
        border-radius: self.height / 2;
        background: Theme.tile;
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            Rectangle {
                input := TextInput {
                    width: 100%;
                    height: 100%;
                    vertical-alignment: center;
                    font-size: 13.5px;
                    color: Theme.text;
                    font-family: Theme.mono;
                    accessible-label: "Command to run";
                    accepted => { root.run(self.text); }
                    init => { self.focus(); }
                }
                if input.text == "": Text {
                    x: 0;
                    text: "e.g. gnome-text-editor";
                    font-size: 13.5px;
                    color: Theme.text-2;
                }
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button { text: "Cancel"; clicked => { root.dismiss(); } }
        Button { text: "Run"; primary: true; enabled: input.text != ""; clicked => { root.run(input.text); } }
    }
}

// Choose which logical CPUs a process may run on.
export component AffinityDialog inherits Modal {
    in property <string> title;
    // Owned by Rust; the chips flip entries in place.
    in-out property <[bool]> cpus;
    callback select-all();
    callback apply();
    card-width: 520px;

    property <int> per-row: 10;
    property <int> rows: Math.ceil(root.cpus.length / root.per-row);

    Text { text: "Processor affinity"; font-size: 18px; font-weight: 500; color: Theme.text; }
    Text { text: "Which logical CPUs is " + root.title + " allowed to run on? Highlighted ones are allowed."; font-size: 13.5px; color: Theme.text-2; wrap: word-wrap; }
    for r in root.rows: HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for c in root.per-row: Chip {
            property <int> index: r * root.per-row + c;
            visible: self.index < root.cpus.length;
            width: 40px;
            text: self.index;
            mono: true;
            clickable: true;
            selected: root.cpus[self.index];
            clicked => { root.cpus[self.index] = !root.cpus[self.index]; }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Button { text: "All"; clicked => { root.select-all(); } }
        Rectangle { horizontal-stretch: 1; }
        Button { text: "Cancel"; clicked => { root.dismiss(); } }
        Button {
            text: "Apply";
            primary: true;
            clicked => { root.apply(); }
        }
    }
}

export component Toast inherits Rectangle {
    in property <string> text;
    height: 44px;
    width: label.preferred-width + 40px;
    border-radius: self.height / 2;
    background: Theme.text;
    drop-shadow-blur: 20px;
    drop-shadow-color: #00000033;
    label := Text {
        text: root.text;
        font-size: 13.5px;
        color: Theme.card;
    }
}
