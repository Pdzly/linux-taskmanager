import { Theme, Page } from "theme.slint";
import { IconButton, Badge, Chip, Icon } from "components.slint";
import { Icons } from "icons.slint";
import { Summary } from "types.slint";

struct RailItem {
    page: Page,
    icon: string,
    label: string,
}

export component Rail inherits VerticalLayout {
    in property <Page> current;
    callback selected(Page);
    callback end-task();

    property <[RailItem]> items: [
        { page: Page.processes, icon: Icons.processes, label: "Processes" },
        { page: Page.performance, icon: Icons.performance, label: "Performance" },
        { page: Page.history, icon: Icons.history, label: "App history" },
        { page: Page.startup, icon: Icons.startup, label: "Startup apps" },
        { page: Page.users, icon: Icons.users, label: "Users" },
        { page: Page.details, icon: Icons.details, label: "Details" },
        { page: Page.services, icon: Icons.services, label: "Services" },
    ];

    width: 52px;
    spacing: 12px;
    alignment: start;

    for item in root.items: IconButton {
        icon: item.icon;
        label: item.label;
        Tooltip { text: @markdown("\{parent.label}"); }
        size: 48px;
        outlined: true;
        active: root.current == item.page;
        clicked => { root.selected(item.page); }
    }

    Rectangle { vertical-stretch: 1; }

    IconButton {
        icon: Icons.settings;
        label: "Settings";
        Tooltip { text: @markdown("\{parent.label}"); }
        size: 48px;
        outlined: true;
        active: root.current == Page.settings;
        clicked => { root.selected(Page.settings); }
    }
    IconButton {
        icon: Icons.close;
        label: "End task";
        Tooltip { text: @markdown("\{parent.label}"); }
        size: 48px;
        danger: true;
        clicked => { root.end-task(); }
    }
}

export component TopBar inherits HorizontalLayout {
    in property <string> user-name;
    in property <string> user-initials;
    in property <Summary> summary;
    // Refresh rate: index into `refresh-labels`; Rust maps it to an interval.
    in-out property <int> refresh-index: 1;
    callback refresh-changed(int);
    callback theme-toggled();
    in property <bool> top-bar-stats;
    callback top-bar-toggled();
    property <[string]> refresh-labels: ["0.5 s", "1 s", "2 s", "5 s", "Paused"];

    height: 60px;
    spacing: 12px;

    // Summary pill: the reference's "On Meet" bar.
    Rectangle {
        horizontal-stretch: 0;
        background: Theme.card;
        border-radius: self.height / 2;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.shadow;

        HorizontalLayout {
            padding-left: 22px;
            padding-right: 8px;
            spacing: 10px;
            alignment: start;

            Text {
                text: "TaskMonitor";
                font-size: 16px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
            Rectangle { width: 6px; }
            VerticalLayout { alignment: center; Chip { icon: Icons.cpu; text: "CPU  " + root.summary.cpu; mono: true; } }
            VerticalLayout { alignment: center; Chip { icon: Icons.memory; text: "RAM  " + root.summary.ram; mono: true; } }
            VerticalLayout { alignment: center; Chip { icon: Icons.gpu; text: "GPU  " + root.summary.gpu; mono: true; } }
        }
    }

    Rectangle { horizontal-stretch: 1; }

    VerticalLayout {
        alignment: center;
        Rectangle {
            height: 48px;
            border-radius: self.height / 2;
            background: refresh-ta.has-hover ? Theme.hover : Theme.tile;
            accessible-role: button;
            accessible-label: "Refresh rate: " + root.refresh-labels[root.refresh-index];
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 18px;
                spacing: 8px;
                VerticalLayout { alignment: center; Icon { glyph: Icons.clock; size: 18px; } }
                Text {
                    text: root.refresh-labels[root.refresh-index];
                    font-family: Theme.mono;
                    font-size: 13px;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
            refresh-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.refresh-index = Math.mod(root.refresh-index + 1, root.refresh-labels.length);
                    root.refresh-changed(root.refresh-index);
                }
            }
        }
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            icon: Icons.top-bar;
            label: root.top-bar-stats ? "Hide CPU, RAM and GPU from the top bar" : "Show CPU, RAM and GPU in the top bar";
            Tooltip { text: @markdown("\{parent.label}"); }
            size: 48px;
            active: root.top-bar-stats;
            clicked => { root.top-bar-toggled(); }
        }
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            icon: Theme.dark ? Icons.sun : Icons.moon;
            label: Theme.dark ? "Switch to light theme" : "Switch to dark theme";
            size: 48px;
            clicked => { root.theme-toggled(); }
        }
    }

    // User pill: name and uptime, initials badge on the right.
    Rectangle {
        background: Theme.card;
        border-radius: self.height / 2;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.shadow;

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 8px;
            spacing: 12px;

            VerticalLayout {
                alignment: center;
                Text { text: root.user-name; font-size: 14px; font-weight: 500; color: Theme.text; }
                Text { text: "Up " + root.summary.uptime; font-size: 11.5px; color: Theme.text-2; font-family: Theme.mono; }
            }
            VerticalLayout {
                alignment: center;
                Badge {
                    text: root.user-initials;
                    tone: Theme.badges[3];
                    size: 42px;
                }
            }
        }
    }
}
